# ─────────────────────────────────────────────────────────────
# Enactus ISIMG — Web application environment
# Copy this file to `.env.local` and fill in real values.
# NEVER commit real secrets. Production secrets live in the
# hosting platform (Vercel) environment settings.
# ─────────────────────────────────────────────────────────────

# PostgreSQL connection string (Prisma)
# Example for a hosted provider (Supabase/Neon/Railway):
#   postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/enactus_isimg?schema=public

# Secret used to sign session JWTs.
# Generate with:  openssl rand -base64 48
# Keep it long and random. Never reuse across environments.
JWT_SECRET=replace-me-with-a-long-random-secret

# Public base URL of the deployed site (used for canonical links/OG).
# In dev this stays http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Comma-separated list of email addresses that become ADMIN on seed
SEED_ADMIN_EMAILS=admin@enactus-isimg.tn

# Contact email shown publicly in the footer / contact page
CONTACT_EMAIL=enactus.isimg@gmail.com

# ── Password reset email ───────────────────────────────────────
# Two transports are supported; SMTP wins when RESET_SMTP_HOST is set.
# Leave unset in dev/testing; see PASSWORD_RESET_DEV_LINK below.
#
# A) SMTP transport (nodemailer)
# RESET_SMTP_HOST=smtp.example.com
# RESET_SMTP_PORT=587
# RESET_SMTP_SECURE=false            # true for port 465 (implicit TLS)
# RESET_SMTP_USER=apikey
# RESET_SMTP_PASS=secret
# RESET_SMTP_REJECT_UNAUTHORIZED=true
#
# B) Generic HTTP email API (e.g. Resend)
# RESET_EMAIL_API_URL=https://api.resend.com/emails
# RESET_EMAIL_API_TOKEN=re_xxxxxxxx
#
# C) Shared
# RESET_EMAIL_FROM=Enactus ISIMG <no-reply@enactus-isimg.tn>

# Non-production ONLY: returns the reset link in the forgot-password
# response so you can test the full flow without an email provider.
# Must never be enabled in production.
# PASSWORD_RESET_DEV_LINK=true