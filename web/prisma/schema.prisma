generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MEMBER
}

enum MemberStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MissionStatus {
  LIVE
  PENDING_REVIEW
  APPROVED
}

model User {
  id           String           @id @default(cuid())
  email        String           @unique
  passwordHash String
  fullName     String
  role         Role             @default(MEMBER)
  status       MemberStatus     @default(PENDING)
  department   Department?      @relation(fields: [departmentId], references: [id])
  departmentId String?
  motivation   String?
  memberId     String?          @unique
  memberSince  DateTime?
  institution  String?
  studyLevel   String?
  fieldOfStudy String?
  skills       String[]
  interests    String[]
  availability String?
  linkedin     String?
  github       String?
  portfolioUrl String?
  publicProfile Boolean         @default(true)
  points       Int              @default(0)
  level        String           @default("Junior")
  profilePic   String?
  phone        String?
  bio          String?
  tokenVersion Int              @default(0)
  missions       Mission[]
  activities     Activity[]
  contactMessages ContactMessage[]
  passwordResetTokens PasswordResetToken[]
  achievements   UserAchievement[]
  certificates   Certificate[]        @relation("ReceivedCertificates")
  issuedCertificates Certificate[]    @relation("IssuedCertificates")
  eventRegistrations EventRegistration[]
  projectMemberships ProjectMember[]
  notifications  Notification[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([role])
  @@index([status])
  @@index([departmentId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model RateLimit {
  id          String   @id @default(cuid())
  key         String
  windowStart Int
  count       Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@unique([key, windowStart])
  @@index([windowStart])
}

model Department {
  id          String     @id @default(cuid())
  name        String     @unique
  slug        String     @unique
  description String?
  icon        String?
  members     User[]
  projects    Project[]
  createdAt   DateTime   @default(now())
}

model Project {
  id           String     @id @default(cuid())
  name         String
  slug         String     @unique
  tag          String
  problem      String
  solution     String
  impact       String
  image        String?
  progress     Int        @default(0)
  order        Int        @default(0)
  published    Boolean    @default(true)
  department   Department? @relation(fields: [departmentId], references: [id])
  departmentId String?
  members      ProjectMember[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([published])
  @@index([departmentId])
}

model TeamMember {
  id           String   @id @default(cuid())
  name         String
  role         String
  image        String?
  facebook     String?
  instagram    String?
  email        String?
  isLeadership Boolean  @default(false)
  order        Int      @default(0)
  published    Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@index([isLeadership])
}

model Event {
  id          String   @id @default(cuid())
  title       String
  description String?
  date        DateTime
  location    String?
  published   Boolean  @default(true)
  registrations EventRegistration[]
  certificates Certificate[]
  createdAt   DateTime @default(now())

  @@index([published, date])
  @@index([date])
}

model News {
  id          String   @id @default(cuid())
  title       String
  description String
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([published])
}

model Mission {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  text          String
  points        Int           @default(50)
  status        MissionStatus @default(LIVE)
  workLink      String?
  submitted     Boolean       @default(false)
  completed     Boolean       @default(false)
  pointsAwarded Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([userId])
  @@index([status])
}

model Activity {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String
  title       String
  description String?
  points      Int      @default(0)
  hours       Int      @default(0)
  refId       String?
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@index([refId])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String
  read      Boolean  @default(false)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([read])
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

enum AchievementCriteria {
  MANUAL
  MISSIONS_COMPLETED
  XP_TOTAL
  EVENTS_ATTENDED
  PROJECTS_JOINED
}

model Achievement {
  id          String                @id @default(cuid())
  name        String
  description String
  icon        String                @default("trophy")
  criteria    AchievementCriteria   @default(MANUAL)
  threshold   Int                   @default(0)
  xpReward    Int                   @default(0)
  active      Boolean               @default(true)
  earnedBy    UserAchievement[]
  certificates Certificate[]
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([active])
}

model UserAchievement {
  id            String      @id @default(cuid())
  userId        String
  achievementId String
  earnedAt      DateTime    @default(now())
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId, earnedAt])
}

enum CertificateStatus {
  ACTIVE
  REVOKED
}

model Certificate {
  id                String            @id @default(cuid())
  certificateNumber String            @unique
  title             String
  description       String?
  userId            String
  issuedById        String
  eventId           String?
  achievementId     String?
  status            CertificateStatus @default(ACTIVE)
  issueDate         DateTime          @default(now())
  createdAt         DateTime          @default(now())
  user              User              @relation("ReceivedCertificates", fields: [userId], references: [id], onDelete: Cascade)
  issuedBy          User              @relation("IssuedCertificates", fields: [issuedById], references: [id], onDelete: Restrict)
  event             Event?            @relation(fields: [eventId], references: [id], onDelete: SetNull)
  achievement       Achievement?      @relation(fields: [achievementId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([eventId])
  @@index([achievementId])
}

enum EventRegistrationStatus {
  REGISTERED
  ATTENDED
}

model EventRegistration {
  id           String                @id @default(cuid())
  eventId      String
  userId       String
  status       EventRegistrationStatus @default(REGISTERED)
  hours        Int                   @default(0)
  registeredAt DateTime              @default(now())
  attendedAt   DateTime?
  event        Event                 @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId])
  @@index([status])
  @@index([eventId])
}

enum ProjectMemberStatus {
  PENDING
  APPROVED
  REJECTED
}

model ProjectMember {
  id          String              @id @default(cuid())
  projectId   String
  userId      String
  role        String              @default("Member")
  status      ProjectMemberStatus @default(PENDING)
  requestedAt DateTime            @default(now())
  respondedAt DateTime?
  project     Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
  @@index([status])
  @@index([projectId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String?
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
}