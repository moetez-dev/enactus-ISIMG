{
  "name": "enactus-isimg-web",
  "version": "1.0.0",
  "private": true,
  "description": "Enactus ISIMG — modern web platform (Next.js + TypeScript + Tailwind + Prisma)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check src",
    "typecheck": "tsc --noEmit",
