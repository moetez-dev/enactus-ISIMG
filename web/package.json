    "next": "14.2.35",
    "nodemailer": "^9.0.5",
    "qrcode": "^1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.53.2",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@types/bcryptjs": "2.4.6",
    "@types/node": "20.17.6",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "autoprefixer": "10.4.20",
